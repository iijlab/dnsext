; The zone with the CNAME.  The target is in another zone, so this zone
; has nothing to say about its address and does not try to -- what it
; sends about it comes from extra.zone instead.
$ORIGIN example.
$TTL 3600
@	IN	SOA	ns.example. root.example. 1 3600 900 604800 3600
@	IN	NS	ns.example.
ns	IN	{{AUTH_ADDR_RR}}
alias	IN	CNAME	www.elsewhere.
