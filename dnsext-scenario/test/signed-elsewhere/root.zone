; The root vouches for example. with a DS made from the key clove
; generated for it.  The key is real and the DS is right: what is wrong
; is further down.
$ORIGIN .
$TTL 3600
@		IN	SOA	ns.root. root.root. 1 3600 900 604800 3600
@		IN	NS	ns.root.
ns.root.	IN	A	{{ROOT_ADDR}}
kept.		IN	A	203.0.113.1
example.	IN	NS	ns.example.
ns.example.	IN	{{AUTH_ADDR_RR}}
example.	IN	DS	{{DS example}}
