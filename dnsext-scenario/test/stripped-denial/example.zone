; A signed zone delegating a child it does not vouch for.  Signed as it
; is, it would send an NSEC3 to prove there is no DS -- and this one
; leaves every NSEC3 out, so the referral proves nothing.
$ORIGIN example.
$TTL 3600
@	IN	SOA	ns.example. root.example. 1 3600 900 604800 3600
@	IN	NS	ns.example.
ns	IN	{{AUTH_ADDR_RR}}
www	IN	A	192.0.2.1
sub	IN	NS	ns.sub.example.
ns.sub	IN	A	{{ROOT_ADDR}}
