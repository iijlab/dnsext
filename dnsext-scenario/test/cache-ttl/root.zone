; One zone delegated, unsigned: what is being timed here is the cache,
; and a signed zone would have its signatures to time as well.
$ORIGIN .
$TTL 3600
@		IN	SOA	ns.root. root.root. 1 3600 900 604800 3600
@		IN	NS	ns.root.
ns.root.	IN	A	{{ROOT_ADDR}}
example.	IN	NS	ns.example.
ns.example.	IN	{{AUTH_ADDR_RR}}
