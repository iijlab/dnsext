; The same shape as example., signed the same way, and sending
; everything it signs.  A wildcard answer from here arrives with the
; NSEC3 which says nothing closer than the wildcard exists, which is
; what makes it this name's answer.
$ORIGIN intact.
$TTL 3600
@		IN	SOA	ns.intact. root.intact. 1 3600 900 604800 3600
@		IN	NS	ns.intact.
ns		IN	{{AUTH_ADDR_RR}}
*.wild		IN	A	192.0.2.8
