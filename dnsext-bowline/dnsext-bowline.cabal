cabal-version:      >=1.10
name:               dnsext-bowline
version:            0.0.0
license-file:       LICENSE
maintainer:         ex8k.hibino@gmail.com, kazu@iij.ad.jp
author:             Kei Hibino and Kazu Yamamoto
build-type:         Configure
data-files:
    bowline/bowline.conf
    bowline/local-example.conf
    bowline/stub-example.conf
    bowline/svcb-example.conf
    clove/clove.conf
    clove/tsig.conf

extra-source-files:
    CHANGELOG.md
    config.guess
    config.sub
    configure.ac
    configure
    include/HsSockOptConfig.h.in
    include/HsSockOpt.h

extra-tmp-files:
    config.log
    config.status
    autom4te.cache
    include/HsSockOptConfig.h

executable bowline
    main-is:          bowline.hs
    build-tools:      hsc2hs >=0
    hs-source-dirs:   bowline
    other-modules:
        Config
        DNSTAP
        Monitor
        Prometheus
        SockOpt
        SocketUtil
        Types
        WebAPI

    default-language: Haskell2010
    include-dirs:     include
    ghc-options:
        -Wall -threaded -rtsopts "-with-rtsopts=-N4 -qn1 -T -A32m -kc2k"

    build-depends:
        base,
        async,
        bytestring,
        dnsext-dnssec,
        dnsext-do53,
        dnsext-iterative,
        dnsext-svcb,
        dnsext-types,
        dnsext-utils,
        http-types,
        iproute,
        network >=3.2.3 && <3.3,
        split,
        stm,
        tls >=2.3.0 && < 2.5,
        tls-session-manager >= 0.1.0 && <0.2,
        transformers,
        unix,
        wai,
        warp

    if (os(windows) && impl(ghc >=9.0))
        ghc-options: -with-rtsopts=--io-manager=native

    if impl(ghc >=8)
        default-extensions: Strict StrictData

executable dug
    main-is:          dug.hs
    hs-source-dirs:   dug
    other-modules:
        Iterative
        JSON
        Output
        Recursive
        SocketUtil
        Types

    default-language: Haskell2010
    ghc-options:      -Wall -threaded
    build-depends:
        base,
        ansi-terminal,
        async,
        base16-bytestring,
        bytestring,
        directory,
        dnsext-dnssec,
        dnsext-do53,
        dnsext-dox,
        dnsext-iterative,
        dnsext-svcb,
        dnsext-types,
        dnsext-utils,
        iproute,
        network,
        prettyprinter,
        quic >=0.3.0 && <0.4,
        random,
        serialise,
        stm,
        tls >=2.3.0 && < 2.5,
        transformers,
        unix-time

    if (os(windows) && impl(ghc >=9.0))
        ghc-options: -with-rtsopts=--io-manager=native

    if impl(ghc >=8)
        default-extensions: Strict StrictData

executable ddrd
    main-is:          ddrd.hs
    hs-source-dirs:   ddrd
    default-language: Haskell2010
    ghc-options:      -Wall -threaded
    build-depends:
        base,
        async,
        bytestring,
        containers,
        dnsext-dnssec,
        dnsext-do53,
        dnsext-dox,
        dnsext-svcb,
        dnsext-types,
        dnsext-utils,
        fast-logger,
        iproute,
        network,
        stm,
        unix

    if (os(windows) && impl(ghc >=9.0))
        ghc-options: -with-rtsopts=--io-manager=native

    if impl(ghc >=8)
        default-extensions: Strict StrictData

executable clove
    main-is:          clove.hs
    hs-source-dirs:   clove
    other-modules:
                      Algo
                      AtomicFile
                      Auth
                      Axfr
                      Config
                      Exception
                      KeyFile
                      Net
                      Notify
                      Serial
                      TSIGKeys
                      Types
                      Zone

    default-language: Haskell2010
    -- -c: a zone is a large structure which is built once and then
    -- barely changes, and the copying collector wants room for a second
    -- copy of it every time it collects the oldest generation.
    -- Compacting that generation instead moves what is live within the
    -- memory it is already in.  Reading a zone of a hundred and eighty
    -- thousand records takes 2.4 GB rather than 3.7 GB and is no
    -- slower.
    --
    -- -rtsopts, and no -N: clove runs on one capability, which is
    -- enough for answering, and it is what the RTS options above are
    -- measured with.  An operator who wants more than one says so --
    --
    --     clove +RTS -N4 -RTS /etc/clove.conf
    --
    -- -- which is worth doing where the processor is what is in short
    -- supply: signing a zone, building its database and cutting it up
    -- for a transfer all run on one thread each, so several of them at
    -- once can only overlap if there is somewhere to overlap.  Fifty
    -- transfer requests arriving together delayed an ordinary query by
    -- 12.7 s on one capability and by 4.0 s on four.
    ghc-options:
        -Wall -threaded -rtsopts "-with-rtsopts=-c"
    build-depends:
        -- GHC bundled
        base,
        async,
        base16-bytestring,
        base64-bytestring,
        bytestring,
        containers,
        directory,
        filepath,
        network,
        -- dnsext packages
        dnsext-auth,
        dnsext-dnssec,
        dnsext-do53,
        dnsext-svcb,
        dnsext-types,
        dnsext-utils,
        iproute,
        network-run >= 0.6.0 && < 0.7,
        stm,
        time-manager,
        unix,
        unix-time

    if (os(windows) && impl(ghc >=9.0))
        ghc-options: -with-rtsopts=--io-manager=native

    if impl(ghc >=8)
        default-extensions: Strict StrictData

executable dump
    main-is:          dump.hs
    hs-source-dirs:   dump
    default-language: Haskell2010
    ghc-options:      -Wall -threaded
    build-depends:
        base,
        dnsext-dnssec,
        dnsext-svcb,
        dnsext-types,
        dnsext-utils,
        network,
        pretty-simple

    if impl(ghc >=8)
        default-extensions: Strict StrictData
